{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/upload.js": {
      "maxDuration": 30
    },
    "api/search.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/guia",
      "destination": "/guia.html",
      "permanent": false
    }
  ]
}
